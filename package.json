{
  "name": "smk-alfalah-ppdb",
  "version": "1.0.0",
  "description": "Backend PPDB SMK Al-Falah Bandung (Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start":    "node server.js",
    "dev":      "nodemon server.js",
    "db:init":  "psql $DATABASE_URL -f schema.sql"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt":            "^5.1.1",
    "dotenv":            "^16.4.5",
    "express":           "^4.19.2",
    "express-rate-limit":"^7.3.1",
    "helmet":            "^7.1.0",
    "pg":                "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
